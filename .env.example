# =====================================================================
# RemoteDevBridge Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your '.env' file to version control!
# =====================================================================

# Telegram Bot Credentials
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Strict User Authorization (Mandatory)
# Comma-separated list of numeric Telegram User IDs allowed to interact with the bot.
# Obtain your ID via @userinfobot or @raw_data_bot on Telegram.
# If empty, the application will refuse to start for security reasons.
ALLOWED_USER_IDS=123456789

# AI Engine Selection
# Options:
#   - 'gemini-direct': Connects directly to Google AI Studio API without external CLI
#   - 'gemini': Uses official Gemini CLI tool
#   - 'claude': Uses Claude Code CLI (claude -p)
#   - 'opencode': Uses OpenCode CLI / Aider (supports NVIDIA NIM, Groq, Ollama)
#   - 'custom': Uses CUSTOM_CLI_CMD template
AI_ENGINE=gemini-direct

# Google AI Studio API Key (for 'gemini-direct' or 'gemini')
# Obtain free API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# Anthropic API Key (required if AI_ENGINE='claude')
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NVIDIA NIM / OpenAI Compatible API Configuration (for 'opencode' or 'custom')
# Supports NVIDIA NIM (https://build.nvidia.com), DeepSeek, Groq, Ollama, etc.
OPENAI_API_KEY=your_nvidia_or_openai_api_key_here
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL_NAME=meta/llama-3.3-70b-instruct

# Custom CLI Command Template (required if AI_ENGINE='custom')
# Available placeholders: {prompt}, {project_path}
CUSTOM_CLI_CMD=aider --message "{prompt}" --no-git --yes

# Desktop IDE Launcher Command
# Used by /open command to launch your local editor on your desktop
# Examples: 'code' (VS Code), 'agy' (Antigravity), 'cursor'
IDE_COMMAND=code

# Command Execution Timeout in seconds (default: 300)
COMMAND_TIMEOUT=300

# Default Commit Author Info for /push & /do
GIT_COMMIT_AUTHOR_NAME=RemoteDevBridge
GIT_COMMIT_AUTHOR_EMAIL=bot@remotedevbridge.local
